    "settings.reminder.access.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders Access" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "提醒事項存取權" } } } },
    "settings.reminder.access.request" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Access to Reminders" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "允許存取提醒事項" } } } },
    "settings.reminder.access.granted" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders Access Allowed" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已允許存取提醒事項" } } } },
    "settings.reminder.access.denied.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Reminders access in Settings to create reading reminders." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請在「設定」中允許存取提醒事項，以建立閱讀提醒。" } } } },
    "settings.reminder.access.open.settings" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Settings" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟設定" } } } },
    "settings.application.information.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "App Information" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "應用程式資訊" } } } },
    "settings.website.link.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Official Website" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟官方網站" } } } },
    "settings.website.url" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "https://sharegather.edward-hsu.net/" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "https://sharegather.edward-hsu.net/" } } } },
    "backup.export" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Export Backup" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "匯出備份" } } } },
    "backup.import" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Import Backup" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "匯入備份" } } } },
    "backup.merge" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Merge with Existing Items" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "合併到現有收藏" } } } },
    "backup.replace" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Replace Existing Items" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "取代現有收藏" } } } },
    "backup.import.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose how to restore this backup." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請選擇要如何還原這份備份。" } } } },
    "backup.import.success.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Backup Imported" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "備份匯入完成" } } } },
    "backup.import.success.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your saved items were restored successfully." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你的收藏已成功還原。" } } } },
    "backup.import.failure.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could Not Import Backup" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無法匯入備份" } } } },
    "backup.import.failure.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose a valid ShareGather backup file and try again." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請選擇有效的 ShareGather 備份檔案後再試一次。" } } } },
    "settings.danger.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Danger Zone" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "危險區域" } } } },
    "settings.clear.items" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear All Saved Items" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "清空所有收藏" } } } },
    "settings.clear.items.choice.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear All Saved Items" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "清空所有收藏" } } } },
    "settings.clear.items.choice.message" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This will permanently delete %d saved items and their images. Do you want to keep your categories?" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這將永久刪除 %d 個收藏及其圖片。是否保留分類？" } } } },
    "settings.clear.items.keep.categories" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep Categories" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "保留分類" } } } },
    "settings.clear.items.delete.categories" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete Items and Categories" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "刪除收藏與分類" } } } },
    "app.name" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "ShareGather" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "ShareGather" } } } },
    "privacy.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Saved privately on this device" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "內容會私密地儲存在此裝置" } } } },
    "privacy.subtitle" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No account. No cloud. Available offline." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "不需帳號、不上雲端，離線也能使用。" } } } },
    "privacy.policy.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Privacy Policy" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "隱私權條款" } } } },
    "privacy.policy.last.updated" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Last updated: %@" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "最後更新：%@" } } } },
    "privacy.policy.introduction" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "ShareGather is designed to save content locally on your iPhone for later review. This policy explains how the app handles that content." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "ShareGather 專為在 iPhone 本機儲存內容、供你稍後查看而設計。本條款說明 App 如何處理這些內容。" } } } },
    "privacy.policy.information.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Information ShareGather Stores" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "ShareGather 儲存的資訊" } } } },
    "privacy.policy.information.introduction" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "When you save content through the iOS Share Sheet or the Save to ShareGather action, ShareGather may store:" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "當你透過 iOS 分享選單或「儲存至 ShareGather」操作儲存內容時，ShareGather 可能會儲存：" } } } },
    "privacy.policy.information.content" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "URLs, text, and images that you choose to share with the app." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你選擇分享給 App 的網址、文字和圖片。" } } } },
    "privacy.policy.information.metadata" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The title, description, source, and thumbnail associated with a saved URL when available." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已儲存網址可用時的標題、描述、來源和縮圖。" } } } },
    "privacy.policy.information.preferences" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Categories, item order, pinned-item choices, and the app language you select." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "分類、項目順序、置頂項目選擇，以及你選擇的 App 語言。" } } } },
    "privacy.policy.information.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This information is stored locally in ShareGather's shared App Group container on your device. It is used only to provide the app's saving, organizing, previewing, and re-sharing features." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "這些資訊儲存在裝置上的 ShareGather 共享 App Group 容器，僅用於提供 App 的儲存、整理、預覽和再次分享功能。" } } } },
    "privacy.policy.no.account.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No Account, Tracking, or Cloud Service" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "無帳號、追蹤或雲端服務" } } } },
    "privacy.policy.no.account.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "ShareGather does not require an account or sign-in. The app does not operate its own server or cloud storage service, and it does not include analytics, advertising, tracking, or data-broker integrations. ShareGather does not send your saved content to a ShareGather-controlled server." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "ShareGather 不需要帳號或登入。App 不營運自己的伺服器或雲端儲存服務，也不包含分析、廣告、追蹤或資料經紀商整合。ShareGather 不會將你儲存的內容傳送至 ShareGather 控制的伺服器。" } } } },
    "privacy.policy.metadata.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "URL Metadata Requests" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "網址中繼資料請求" } } } },
    "privacy.policy.metadata.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "For a shared URL, ShareGather may use Apple's Link Presentation framework to request preview metadata, such as a page title or thumbnail. This request is optional: the original URL is saved even if metadata loading fails." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "對於分享的網址，ShareGather 可能使用 Apple 的 Link Presentation 框架請求預覽中繼資料，例如網頁標題或縮圖。這項請求是選用的：即使中繼資料載入失敗，原始網址仍會儲存。" } } } },
    "privacy.policy.metadata.third.party.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "When this occurs, the website associated with the URL and any services it uses may receive your network information, such as your IP address, and may process the request under their own privacy policies. ShareGather does not control those third parties." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "發生這類請求時，該網址所對應的網站及其使用的服務可能會收到你的網路資訊，例如 IP 位址，並依其隱私權政策處理該請求。ShareGather 無法控制這些第三方。" } } } },
    "privacy.policy.reminders.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Optional Reminders Integration" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選用的提醒事項整合" } } } },
    "privacy.policy.reminders.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Only when you choose to create a reading reminder, ShareGather writes the reminder title, notes, scheduled time, and a link to the saved item into your Reminders database. That information may sync through the accounts you configure for Reminders. ShareGather does not operate a server or cloud synchronization service for this feature." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "只有在你選擇建立閱讀提醒時，ShareGather 才會將提醒標題、備註、排定時間與收藏連結寫入你的「提醒事項」資料庫。這些資訊可能依你為「提醒事項」設定的帳號進行同步；ShareGather 不會為此功能營運伺服器或雲端同步服務。" } } } },
    "privacy.policy.backup.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Backup Import and Export" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "備份匯入與匯出" } } } },
    "privacy.policy.backup.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "When you choose to export a backup through the system share sheet, the backup file may contain your saved items, categories, images, and thumbnails. The app or service receiving the file handles it under its own privacy policy. When you import a backup, ShareGather reads the file you select and stores its data on this device." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "當你主動匯出備份並透過系統分享選單傳送時，備份檔案可能包含你的收藏、分類、圖片和縮圖。接收檔案的 App 或服務會依其隱私權政策處理該檔案。匯入備份時，ShareGather 會從你選擇的檔案讀取資料並儲存在此裝置。" } } } },
    "privacy.policy.choices.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your Choices and Data Deletion" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你的選擇與資料刪除" } } } },
    "privacy.policy.choices.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You control the content you save. You can delete individual items, delete categories, move items to Uncategorized, or use Clear All Saved Items in Settings. Clearing saved items removes the stored item data and associated local images and thumbnails. You can choose whether to keep or delete categories when clearing all saved items. Deleting the app may remove its local data. Do not rely on deleting and reinstalling the app as a backup or export method." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你可以控制儲存的內容。你可以刪除單一項目、刪除分類、將項目移至未分類，或在設定中使用「清空所有收藏」。清空收藏會移除儲存的項目資料及相關的本機圖片和縮圖；你可選擇保留或刪除分類。刪除 App 可能會移除本機資料，請勿將刪除後重新安裝視為備份或匯出方式。" } } } },
    "privacy.policy.changes.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Changes to This Policy" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "本條款的變更" } } } },
    "privacy.policy.changes.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "If ShareGather's data practices change, this policy will be updated in this repository with a revised date." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "若 ShareGather 的資料處理方式有所變更，本條款會在此程式碼庫更新，並標示修訂日期。" } } } },
    "privacy.policy.contact.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Contact" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "聯絡方式" } } } },
    "privacy.policy.contact.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "For privacy questions or feedback, please open an issue in the ShareGather project repository." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "若有隱私問題或意見回饋，請在 ShareGather 專案程式碼庫建立 issue。" } } } },
    "privacy.policy.repository.link.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open GitHub Repository" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟 GitHub Repository" } } } },
    "privacy.policy.repository.url" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "https://github.com/edward-hsu-1994/ShareGather" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "https://github.com/edward-hsu-1994/ShareGather" } } } },
    "empty.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Save it for later" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "先收藏，之後再看" } } } },
    "empty.description" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Share links, images, or text from your favorite apps and find them here when you have time." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "從喜歡的 App 分享連結、圖片或文字，等有空時再回來查看。" } } } },
    "share.card.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Save from another app" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "從其他 App 收藏內容" } } } },
    "share.instructions.view" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "View instructions" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "查看使用方式" } } } },
    "library.saved.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your saved items" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "你的收藏" } } } },
    "library.recent.title" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recent saved items" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "最近的收藏" } } } },
    "library.recent.empty" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your recent saved items will appear here." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "最近收藏的內容會顯示在這裡。" } } } },
    "library.uncategorized" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Uncategorized" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "未分類" } } } },
    "library.saved.image" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Saved image" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "已儲存的圖片" } } } },
    "library.item.detail" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Saved item" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "收藏內容" } } } },
    "library.link" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Link" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "連結" } } } },
    "library.open.link" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open link" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟連結" } } } },
    "library.share" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Share" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "分享" } } } },
    "library.text" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Text" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "文字" } } } },
