// Shared.xcconfig
// Minimal shared configuration for scaffold tool customization
// All other settings use Xcode project defaults
// Generated by XcodeBuildMCP

// ==========================================
// Project Identity
// ==========================================
PRODUCT_NAME = ShareGather
PRODUCT_DISPLAY_NAME = ShareGather
PRODUCT_BUNDLE_IDENTIFIER = com.sharegather.app
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// ==========================================
// Platform Configuration
// ==========================================
IPHONEOS_DEPLOYMENT_TARGET = 17.0

// (1 == iPhone)
TARGETED_DEVICE_FAMILY = 1

// ==========================================
// Info PLIST
// ==========================================
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = portrait

// ==========================================
// Entitlements
// ==========================================
// AI agents can modify Config/ShareGather.entitlements to add capabilities
CODE_SIGN_ENTITLEMENTS = Config/ShareGather.entitlements
